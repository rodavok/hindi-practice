  "grammar": [
   {
    "id": "infinitive",
    "title": "The infinitive is stem + -nā (always a full न): बोलना, stem बोल-. The stem is the basis of many verb forms"
   },
   {
    "id": "imperative",
    "title": "Commands: तू takes the bare stem (intimate or blunt), तुम stem + -o, आप stem + -ie; -iegā is extra polite; the infinitive can be a (deferred) command, mostly in तुम contexts"
   },
   {
    "id": "imperative-irregular",
    "title": "Irregular आप commands कीजिए, लीजिए, दीजिए, पीजिए; irregular तुम commands लो, दो; पीना gives पियो"
   },
   {
    "id": "neg-command",
    "title": "Commands are made negative with न or, more forcefully, मत before the verb"
   },
   {
    "id": "se-kahna",
    "title": "कहना “to say” and पूछना “to ask” mark the person addressed with से (बताना and देना take को)"
   },
   {
    "id": "sunie",
    "title": "सुनिए “please listen” politely attracts attention"
   },
   {
    "id": "possession-ka",
    "title": "Possession with का: the owner is oblique; का, की, के agrees with the thing possessed and is के when that is oblique; pronouns: उसका, उनका, किसका …"
   },
   {
    "id": "ko-objects",
    "title": "को marks the indirect object (X को दो); a direct object takes को when it is specific, and nearly always when it is a person"
   },
   {
    "id": "pronoun-ko-short",
    "title": "Short forms of pronoun + को: मुझे, तुझे, इसे, उसे, हमें, तुम्हें, इन्हें, उन्हें, किसे, किन्हें (आप को has none)"
   },
   {
    "id": "kaunsa",
    "title": "कौनसा “which?” agrees like an -ā adjective"
   }
  ]
 }
