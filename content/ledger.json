  "grammar": [
   {
    "id": "be-past",
    "title": "Past tense of होना — था (m sg), थी (f sg), थे (m pl), थीं (f pl); unlike है it shows gender; आप, तुम, हम and respected people take the plural"
   },
   {
    "id": "to",
    "title": "तो — at the start of a phrase “so, then”; after a word it contrasts that word with something else; it is not a postposition and does not affect case"
   },
   {
    "id": "comparison",
    "title": "Comparison: X Y से adjective (“X is more … than Y”), with the compared noun oblique; ज़्यादा or और “more”, कम “less”; superlative with सब से"
   },
   {
    "id": "ko-construction",
    "title": "को constructions: मुझ को ज़ुकाम है — the thing (ज़ुकाम, बुख़ार, अफ़सोस, आशा, ख़ुशी, or what is मालूम/पसंद) is the subject and the verb agrees with it; the person is oblique with को"
   },
   {
    "id": "ki-clause",
    "title": "कि “that” introduces a clause; an embedded question keeps the order of the direct question (… मालूम है कि राज कहाँ है)"
   },
   {
    "id": "vocative",
    "title": "Vocative case: like the oblique, but the plural ending is -o without a nasal (बेटे ! बच्चो ! भाइयो !)"
   },
   {
    "id": "kya-final",
    "title": "In casual speech the yes/no क्या can come at the end of the sentence"
   },
   {
    "id": "kal",
    "title": "कल means “yesterday” or “tomorrow”; the tense shows which"
   }
  ]
 },
