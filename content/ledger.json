  "grammar": [
   {
    "id": "imperfective-present",
    "title": "Imperfective present: stem + -tā, -tī, -te (agreeing with the subject) + हूँ, है, हो, हैं, for habits, regular events and ongoing states of mind"
   },
   {
    "id": "imperfective-negative",
    "title": "In the negative the auxiliary can be dropped; a feminine plural participle is then nasalized (नहीं बोलतीं)"
   },
   {
    "id": "imperfective-idiom",
    "title": "Idiomatic imperfective for something about to happen: अच्छा, मैं चलता हूँ “I'm off”, अभी आता हूँ"
   },
   {
    "id": "kitne-baje",
    "title": "कितने बजे ? “at what time?”; सात बजे “at seven o'clock”"
   },
   {
    "id": "ana-language",
    "title": "Knowing a language: X को (language) आना, the verb agreeing with the language"
   },
   {
    "id": "kya-kahte",
    "title": "X को क्या कहते हैं ? “what is X called?”; X को Y कहना “to call X Y”"
   },
   {
    "id": "hota-hai",
    "title": "होता है for general statements of lasting validity, है alone for a particular case"
   },
   {
    "id": "malum-hota",
    "title": "मालूम होता है “it seems” against मुझे मालूम है “I know”"
   },
   {
    "id": "mixed-gender-verb",
    "title": "Mixed genders: people take a masculine plural verb; things take the gender of the nearest item"
   },
   {
    "id": "possessive-pronouns",
    "title": "The full set of possessive pronouns: मेरा, तेरा, इसका, उसका, हमारा, तुम्हारा, आपका, इनका, उनका, किसका, किनका; they agree with the thing possessed; the possessive before the noun describes it, after the noun it is the predicate (यह मेरी साइकिल है against यह साइकिल मेरी है)"
   },
   {
    "id": "saal-ka",
    "title": "X साल का “X years old”, का agreeing with the person; साल stays unpluralized as a single block of time"
   },
   {
    "id": "apna",
    "title": "अपना refers to the subject of the clause and replaces the possessive; not used for the subject itself or in a joint subject; always used for “your” in commands; मेरा अपना “my very own”"
   },
   {
    "id": "compound-postpositions",
    "title": "Compound postpositions (के लिए, के साथ, के पास, के बारे में …; की तरफ़, की तरह, से पहले) take the oblique; with pronouns they use the possessive: मेरे लिए, उसके साथ"
   },
   {
    "id": "pronoun-construction-types",
    "title": "Two construction types: वह बीमार है and उसे ज़ुकाम है, where the thing is the subject and the person takes को"
   }
  ]
 },
